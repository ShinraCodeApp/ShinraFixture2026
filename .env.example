# =====================================================
# ShinraFixture 2026 - Environment Variables
# =====================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ── Application ──────────────────────────────────────
NODE_ENV=development
APP_NAME=ShinraFixture2026
APP_VERSION=1.0.0
PORT=4000
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# ── Database (PostgreSQL) ─────────────────────────────
DATABASE_URL=postgresql://shinra:shinra_pass@localhost:5432/shinra_db?schema=public
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=shinra_db
DATABASE_USER=shinra
DATABASE_PASSWORD=shinra_pass

# ── Redis Cache ────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=3600

# ── JWT Authentication ─────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── OAuth ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

APPLE_CLIENT_ID=your-apple-client-id
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY_PATH=./config/apple-private-key.p8

FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# ── Firebase (Push Notifications) ─────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY=your-firebase-private-key
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com

# ── AWS S3 (Media Storage) ─────────────────────────────
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=shinra-fixture-media
AWS_CLOUDFRONT_URL=https://your-cloudfront-url.cloudfront.net

# ── OpenAI (AI Predictions) ───────────────────────────
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4-turbo-preview
AI_ENABLED=true

# ── Sports Data API ────────────────────────────────────
SPORTS_API_KEY=your-sports-api-key
SPORTS_API_URL=https://api.football-data.org/v4
LIVE_DATA_PROVIDER=api-football
API_FOOTBALL_KEY=your-api-football-key

# ── Email (SendGrid) ──────────────────────────────────
SENDGRID_API_KEY=your-sendgrid-api-key
EMAIL_FROM=noreply@shinrafixture.com
EMAIL_FROM_NAME=ShinraFixture 2026

# ── Stripe (Payments/Premium) ─────────────────────────
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
PREMIUM_MONTHLY_PRICE_ID=price_xxxxx
PREMIUM_ANNUAL_PRICE_ID=price_yyyyy

# ── Rate Limiting ─────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX=10

# ── Logging ───────────────────────────────────────────
LOG_LEVEL=debug
LOG_FORMAT=json

# ── Monitoring ────────────────────────────────────────
SENTRY_DSN=your-sentry-dsn
NEW_RELIC_LICENSE_KEY=your-new-relic-key

# ── Feature Flags ─────────────────────────────────────
FEATURE_AI_PREDICTIONS=true
FEATURE_LIVE_SCORES=true
FEATURE_QUINIELA=true
FEATURE_SIMULATOR=true
FEATURE_COMMUNITY=true
