{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      },
      "env": {
        "EXPO_NO_METRO_WORKSPACE_ROOT": "1",
        "EXPO_PUBLIC_API_URL": "https://shinraapi-production.up.railway.app/api/v1",
        "EXPO_PUBLIC_WS_URL": "https://shinraapi-production.up.railway.app"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
